# Infra host ports (5432 is taken by another project on this machine)
POSTGRES_PORT=55432
REDIS_PORT=56379
DATABASE_URL=postgres://zoomclone:zoomclone@localhost:55432/zoomclone
REDIS_URL=redis://localhost:56379/0

# meeting-api
NODE_ENV=development
MEETING_API_PORT=8080
LOG_LEVEL=info
TOKEN_ISSUER=meeting-api
# SIGNING_KEY_PEM= PKCS8 ES256 private key; generated per process when unset outside production
SIGNING_KID=dev-1
AUTH_DEV_ISSUER=true
DEV_ISSUER_URL=http://localhost:8080/dev/oidc
OIDC_AUDIENCE=zoomclone
# OIDC_ISSUER= and OIDC_JWKS_URL= are required when AUTH_DEV_ISSUER=false
# OIDC_ALGORITHMS=RS256,ES256
# OIDC_REQUIRE_ORG=false
DEFAULT_ORG_ID=11111111-1111-4111-8111-111111111111
DEFAULT_REGION=local
SFU_ID=sfu-local-1
SIGNALING_PUBLIC_URL=ws://localhost:8081
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=3600
JOIN_RATE_LIMIT=10
JOIN_RATE_LIMIT_PER_CODE=120
JOIN_RATE_WINDOW_MS=60000
# Set to true behind a reverse proxy, else the per-IP join limit counts every client as one.
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:8081

# sfu
SFU_GRPC_PORT=9090
SFU_WORKERS=2
SFU_MEDIA_PORT_BASE=40000
SFU_LISTEN_IP=0.0.0.0
SFU_ANNOUNCED_IP=127.0.0.1
SFU_QOS_INTERVAL_MS=5000
SFU_AUDIO_LEVEL_INTERVAL_MS=300
SFU_INITIAL_OUTGOING_BITRATE=1000000
MEDIASOUP_LOG_LEVEL=warn

# signaling
SIGNALING_PORT=8081
MEETING_API_JWKS_URL=http://localhost:8080/.well-known/jwks.json
SFU_ENDPOINTS=sfu-local-1=http://localhost:9090
DISCONNECT_GRACE_MS=30000
ROOM_IDLE_TIMEOUT_MS=300000
MEETING_API_PUBLIC_URL=http://localhost:8080
# serves the browser client at /dev/; set false in production
# (the service refuses to start with DEV_HARNESS=true when NODE_ENV=production)
DEV_HARNESS=true
